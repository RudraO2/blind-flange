node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
dist/
build/
.DS_Store
Thumbs.db

# model weights and caches - never commit, always pre-staged separately
*.gguf
*.safetensors
models/
.cache/

# BMAD working output — scratch is ignored, planning artifacts are KEPT.
# The brief and the epics/stories are the plan; losing them to a machine failure
# would cost more than the repo weight of a few markdown files.
_bmad-output/*
!_bmad-output/planning-artifacts/

# The sprint tracker is KEPT — it is the issue tracker and the build loop's memory
# of where it got to, not throwaway. Everything else under implementation-artifacts
# is build scratch and stays ignored: the loop takes the one-shot route and writes
# no spec or epic-context files, so an un-ignored `*.md` here only ever surfaced
# leftovers from the earlier full route as permanently untracked noise.
!_bmad-output/implementation-artifacts/
_bmad-output/implementation-artifacts/*
!_bmad-output/implementation-artifacts/sprint-status.yaml

# Claude Code worktrees — Lane B works in one; never commit a worktree tree.
.claude/worktrees/

# Story 5.4's approval-note tool writes real .docx files here at runtime
# (session cwd defaults to the repo root under `dsh --profile headless`).
# Generated output, never source.
/deliverables/
